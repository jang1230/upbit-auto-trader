{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Upbit Auto Trader V4 Configuration Schema",
  "type": "object",
  "required": ["version", "global_settings", "groups"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^4\\.\\d+\\.\\d+$",
      "description": "Configuration version (4.x.x)"
    },
    "global_settings": {
      "type": "object",
      "required": ["dry_run"],
      "properties": {
        "trading_day_reset_hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23,
          "default": 9,
          "description": "Hour to reset daily counters (0-23, default: 9)"
        },
        "max_positions": {
          "type": "object",
          "required": ["enabled", "limit"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable maximum position limit"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum number of concurrent positions"
            }
          }
        },
        "min_krw_balance": {
          "type": "object",
          "required": ["enabled", "amount"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "amount": {
              "type": "number",
              "minimum": 0,
              "description": "Minimum KRW balance to maintain (in KRW)"
            }
          }
        },
        "daily_loss_limit": {
          "type": "object",
          "required": ["enabled", "loss_pct", "calculation_method", "action"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "loss_pct": {
              "type": "number",
              "minimum": 1,
              "maximum": 50,
              "description": "Daily loss limit percentage (1-50%)"
            },
            "calculation_method": {
              "type": "string",
              "enum": ["daily_only", "total_account"],
              "description": "How to calculate daily loss"
            },
            "action": {
              "type": "string",
              "enum": ["alert", "liquidate"],
              "description": "Action when limit is reached"
            }
          }
        },
        "position_loss_limit": {
          "type": "object",
          "required": ["enabled", "limit_pct", "action", "exclude_observation_groups"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable position loss limit"
            },
            "limit_pct": {
              "type": "number",
              "minimum": -50,
              "maximum": 0,
              "description": "Position loss limit percentage (negative value, e.g., -10.0 for -10%)"
            },
            "action": {
              "type": "string",
              "enum": ["alert", "liquidate"],
              "description": "Action when limit is reached"
            },
            "exclude_observation_groups": {
              "type": "boolean",
              "description": "Whether to exclude observation_only groups from loss calculation"
            }
          }
        },
        "telegram": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "token": {
              "type": "string",
              "description": "Telegram bot token"
            },
            "chat_id": {
              "type": "string",
              "description": "Telegram chat ID"
            }
          }
        },
        "dry_run": {
          "type": "boolean",
          "description": "If true, use virtual balance (paper trading)"
        }
      }
    },
    "groups": {
      "type": "object",
      "description": "Trading groups configuration (dictionary with group_id as key)",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "required": ["name", "coins", "observation_only", "buy_settings", "dca_settings", "profit_settings", "loss_settings"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50,
              "description": "Group display name"
            },
            "observation_only": {
              "type": "boolean",
              "description": "If true, this group is observation-only (no trading)"
            },
            "coins": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^KRW-[A-Z0-9]+$"
              },
              "uniqueItems": true,
              "description": "List of coin symbols in this group"
            },
            "buy_settings": {
              "type": "object",
              "required": ["mode"],
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["manual", "auto", "disabled"],
                  "description": "Buy mode: manual (buy on Upbit), auto (strategy-based), disabled (no buying)"
                },
                "auto_config": {
                  "type": "object",
                  "description": "Auto-buy configuration (required if mode=auto)",
                  "required": ["enabled", "strategy", "candle_unit", "buy_amount_krw"],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "strategy": {
                      "type": "string",
                      "enum": ["v4_auto_buy", "expert"],
                      "description": "Strategy type: v4_auto_buy (V4AutoBuyStrategy) or expert (ExpertStrategy)"
                    },
                    "investment_style": {
                      "type": "string",
                      "enum": ["conservative", "balanced", "aggressive", "custom"],
                      "description": "Investment style preset (for v4_auto_buy strategy)"
                    },
                    "expert_profile": {
                      "type": "string",
                      "enum": [
                        "rsi_specialist",
                        "momentum_expert",
                        "volatility_expert",
                        "volume_expert",
                        "balanced_expert",
                        "conservative_expert",
                        "aggressive_expert",
                        "trend_follower",
                        "reversal_hunter",
                        "smart_money",
                        "custom"
                      ],
                      "description": "Expert profile (for expert strategy)"
                    },
                    "custom_weights": {
                      "type": "object",
                      "description": "Custom indicator weights (required if expert_profile=custom)",
                      "properties": {
                        "rsi": {"type": "number", "minimum": 0.0, "maximum": 1.0},
                        "macd": {"type": "number", "minimum": 0.0, "maximum": 1.0},
                        "bollinger": {"type": "number", "minimum": 0.0, "maximum": 1.0},
                        "volume": {"type": "number", "minimum": 0.0, "maximum": 1.0},
                        "trend": {"type": "number", "minimum": 0.0, "maximum": 1.0}
                      },
                      "required": ["rsi", "macd", "bollinger", "volume", "trend"]
                    },
                    "custom_threshold": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "Custom confidence threshold percentage (required if expert_profile=custom)"
                    },
                    "candle_unit": {
                      "type": "string",
                      "enum": ["1", "3", "5", "10", "15", "30", "60", "240"],
                      "description": "Candle timeframe in minutes"
                    },
                    "indicators": {
                      "type": "object",
                      "description": "Indicator settings (for v4_auto_buy strategy)",
                      "required": ["rsi", "macd", "volume"],
                      "properties": {
                        "rsi": {
                          "type": "object",
                          "required": ["enabled", "period", "oversold", "overbought"],
                          "properties": {
                            "enabled": {"type": "boolean"},
                            "period": {"type": "integer", "minimum": 5, "maximum": 50},
                            "oversold": {"type": "integer", "minimum": 10, "maximum": 40},
                            "overbought": {"type": "integer", "minimum": 60, "maximum": 90}
                          }
                        },
                        "macd": {
                          "type": "object",
                          "required": ["enabled", "fast", "slow", "signal"],
                          "properties": {
                            "enabled": {"type": "boolean"},
                            "fast": {"type": "integer", "minimum": 5, "maximum": 30},
                            "slow": {"type": "integer", "minimum": 10, "maximum": 50},
                            "signal": {"type": "integer", "minimum": 5, "maximum": 20}
                          }
                        },
                        "volume": {
                          "type": "object",
                          "required": ["enabled", "period", "threshold"],
                          "properties": {
                            "enabled": {"type": "boolean"},
                            "period": {"type": "integer", "minimum": 10, "maximum": 50},
                            "threshold": {"type": "number", "minimum": 1.0, "maximum": 5.0}
                          }
                        }
                      }
                    },
                    "buy_amount_krw": {
                      "type": "integer",
                      "minimum": 5000,
                      "description": "Buy amount per signal (minimum 5,000 KRW)"
                    }
                  }
                }
              }
            },
            "dca_settings": {
              "type": "object",
              "required": ["mode"],
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["auto", "alert", "disabled"],
                  "description": "DCA mode"
                },
                "levels": {
                  "type": "array",
                  "description": "DCA levels (required if mode=auto)",
                  "items": {
                    "type": "object",
                    "required": ["price_ratio", "quantity_ratio"],
                    "properties": {
                      "price_ratio": {
                        "type": "number",
                        "maximum": 0,
                        "description": "Price drop percentage to trigger DCA (negative value, e.g., -10 for -10%)"
                      },
                      "quantity_ratio": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Buy amount as percentage of initial buy (e.g., 100 for same amount, 150 for 1.5x)"
                      }
                    }
                  }
                }
              }
            },
            "profit_settings": {
              "type": "object",
              "required": ["mode"],
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["auto", "alert", "disabled"],
                  "description": "Profit-taking mode"
                },
                "levels": {
                  "type": "array",
                  "description": "Profit-taking levels (required if mode=auto)",
                  "items": {
                    "type": "object",
                    "required": ["price_ratio", "quantity_ratio"],
                    "properties": {
                      "price_ratio": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Price increase percentage to trigger profit-taking (e.g., 5 for +5%)"
                      },
                      "quantity_ratio": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100,
                        "description": "Percentage of current holdings to sell (e.g., 50 for 50%, 100 for all)"
                      }
                    }
                  }
                }
              }
            },
            "loss_settings": {
              "type": "object",
              "required": ["mode"],
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["auto", "alert", "disabled"],
                  "description": "Stop-loss mode"
                },
                "levels": {
                  "type": "array",
                  "description": "Stop-loss levels (required if mode=auto)",
                  "items": {
                    "type": "object",
                    "required": ["price_ratio", "quantity_ratio"],
                    "properties": {
                      "price_ratio": {
                        "type": "number",
                        "maximum": 0,
                        "description": "Price drop percentage to trigger stop-loss (negative value, e.g., -10 for -10%)"
                      },
                      "quantity_ratio": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100,
                        "description": "Percentage of current holdings to sell (e.g., 50 for 50%, 100 for all)"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
