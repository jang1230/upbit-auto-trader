{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Upbit Auto Trader V4 Configuration Schema",
  "type": "object",
  "required": ["version", "global_settings", "groups"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^4\\.\\d+\\.\\d+$",
      "description": "Configuration version (4.x.x)"
    },
    "global_settings": {
      "type": "object",
      "required": ["observation_mode", "dry_run"],
      "properties": {
        "observation_mode": {
          "type": "boolean",
          "description": "If true, no actual trades will be executed (monitoring only)"
        },
        "min_krw_balance": {
          "type": "object",
          "required": ["enabled", "amount"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "amount": {
              "type": "number",
              "minimum": 0,
              "description": "Minimum KRW balance to maintain (in KRW)"
            }
          }
        },
        "daily_loss_limit": {
          "type": "object",
          "required": ["enabled", "loss_pct", "calculation_method", "action"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "loss_pct": {
              "type": "number",
              "minimum": 1,
              "maximum": 50,
              "description": "Daily loss limit percentage (1-50%)"
            },
            "calculation_method": {
              "type": "string",
              "enum": ["daily_only", "total_account"],
              "description": "How to calculate daily loss"
            },
            "action": {
              "type": "string",
              "enum": ["alert", "liquidate"],
              "description": "Action when limit is reached"
            }
          }
        },
        "telegram": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "token": {
              "type": "string",
              "description": "Telegram bot token"
            },
            "chat_id": {
              "type": "string",
              "description": "Telegram chat ID"
            }
          }
        },
        "dry_run": {
          "type": "boolean",
          "description": "If true, use virtual balance (paper trading)"
        }
      }
    },
    "groups": {
      "type": "array",
      "description": "Trading groups configuration",
      "items": {
        "type": "object",
        "required": ["id", "name", "coins", "buy_settings", "dca_settings", "profit_settings", "loss_settings"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^group_\\d+$",
            "description": "Unique group identifier (e.g., group_1737700000000)"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "Group display name"
          },
          "coins": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^KRW-[A-Z0-9]+$"
            },
            "uniqueItems": true,
            "description": "List of coin symbols in this group"
          },
          "buy_settings": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["manual", "auto", "disabled"],
                "description": "Buy mode: manual (buy on Upbit), auto (strategy-based), disabled (no buying)"
              },
              "auto_config": {
                "type": "object",
                "description": "Auto-buy configuration (required if mode=auto)",
                "required": ["enabled", "investment_style", "candle_unit", "indicators", "buy_amount_krw"],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "investment_style": {
                    "type": "string",
                    "enum": ["conservative", "balanced", "aggressive", "custom"],
                    "description": "Investment style preset"
                  },
                  "candle_unit": {
                    "type": "string",
                    "enum": ["1", "3", "5", "15", "30", "60", "240"],
                    "description": "Candle timeframe in minutes"
                  },
                  "indicators": {
                    "type": "object",
                    "required": ["rsi", "macd", "volume"],
                    "properties": {
                      "rsi": {
                        "type": "object",
                        "required": ["enabled", "period", "oversold", "overbought"],
                        "properties": {
                          "enabled": {"type": "boolean"},
                          "period": {"type": "integer", "minimum": 5, "maximum": 50},
                          "oversold": {"type": "integer", "minimum": 10, "maximum": 40},
                          "overbought": {"type": "integer", "minimum": 60, "maximum": 90}
                        }
                      },
                      "macd": {
                        "type": "object",
                        "required": ["enabled", "fast", "slow", "signal"],
                        "properties": {
                          "enabled": {"type": "boolean"},
                          "fast": {"type": "integer", "minimum": 5, "maximum": 30},
                          "slow": {"type": "integer", "minimum": 10, "maximum": 50},
                          "signal": {"type": "integer", "minimum": 5, "maximum": 20}
                        }
                      },
                      "volume": {
                        "type": "object",
                        "required": ["enabled", "period", "threshold"],
                        "properties": {
                          "enabled": {"type": "boolean"},
                          "period": {"type": "integer", "minimum": 10, "maximum": 50},
                          "threshold": {"type": "number", "minimum": 1.0, "maximum": 5.0}
                        }
                      }
                    }
                  },
                  "buy_amount_krw": {
                    "type": "integer",
                    "minimum": 5000,
                    "description": "Buy amount per signal (minimum 5,000 KRW)"
                  }
                }
              }
            }
          },
          "dca_settings": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["auto", "alert", "disabled"],
                "description": "DCA mode"
              },
              "levels": {
                "type": "array",
                "description": "DCA levels (required if mode=auto)",
                "items": {
                  "type": "object",
                  "required": ["drop_pct", "buy_ratio"],
                  "properties": {
                    "drop_pct": {
                      "type": "number",
                      "maximum": 0,
                      "description": "Price drop percentage to trigger DCA (negative value)"
                    },
                    "buy_ratio": {
                      "type": "number",
                      "minimum": 0.1,
                      "description": "Buy amount multiplier (e.g., 1.5 = 1.5x initial buy)"
                    }
                  }
                }
              }
            }
          },
          "profit_settings": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["auto", "alert", "disabled"],
                "description": "Profit-taking mode"
              },
              "target_pct": {
                "type": "number",
                "minimum": 0.1,
                "description": "Profit target percentage (required if mode=auto)"
              }
            }
          },
          "loss_settings": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["auto", "alert", "disabled"],
                "description": "Stop-loss mode"
              },
              "stop_loss_pct": {
                "type": "number",
                "maximum": 0,
                "description": "Stop-loss percentage (negative value, required if mode=auto)"
              }
            }
          }
        }
      }
    }
  }
}
